{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaserPrep",
  "identifier": "io.github.tvalls.laserprep",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LaserPrep",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNzA5QTczMDYzNzFBMjUKUldRbEdqY0djNXB3dktWZlNlVVNiZVQwTk5jUXJqaHh1aVdNZm9SMTRDalVSU2djZk1YQitzMlUK",
      "endpoints": [
        "https://github.com/tvalls/LaserPrep/releases/latest/download/latest.json"
      ]
    }
  }
}
